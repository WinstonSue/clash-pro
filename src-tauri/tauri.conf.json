{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash Pro",
  "version": "0.2.1",
  "identifier": "local.clashpro.desktop",
  "build": { "frontendDist": "shell" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": { "../build/tauri-resources/backend/": "backend/" },
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
